# Switch 的 MAC 地址，在 Switch 的「设置 → 互联网 → 互联网设置」里查看
SWITCH_MAC=aa:bb:cc:dd:ee:ff
# sys-botbase 的端口
SWITCH_PORT=6000
# Switch 的 ip，由 tool/find_switch.py 自动写入，不用手填
# SWITCH_IP=192.168.1.100
# 连接方式：usb 用 usb-botbase，wifi 用 sys-botbase（要上面的 ip 和端口）
SWITCH_CONNECTION=usb
# Discord 频道 Webhook 的 URL，用来发送通知
DISCORD_WEBHOOK_URL=
