# ---- 连接 Switch ----

# 连接方式：usb 用 usb-botbase（只要插着 USB 线），wifi 用 sys-botbase（要下面的 MAC、端口和 ip）
SWITCH_CONNECTION=usb
# Switch 的 MAC 地址，在 Switch 的「设置 → 互联网 → 互联网设置」里查看。
# make find 用它在局域网里找 Switch 的 ip；只用 USB 连接时用不到
SWITCH_MAC=aa:bb:cc:dd:ee:ff
# sys-botbase 的端口，Wi-Fi 连接时用
SWITCH_PORT=6000
# Switch 的 ip，Wi-Fi 连接时用。由 make find（src/tools/find_switch.py）自动写入，不用手填
# SWITCH_IP=192.168.1.100

# ---- PKHeX 服务 ----

# 解析宝可梦内存数据的服务地址，服务用 docker/pkhex-reader 启动。
# 不写就用默认的 http://127.0.0.1:8787/api/v1/execute，服务在别的机器或端口上才要改
# PKHEX_API_URL=http://127.0.0.1:8787/api/v1/execute

# ---- 通知 ----

# Discord 频道 Webhook 的 URL，用来发每局战报、超时和出错的通知。不填就不发
DISCORD_WEBHOOK_URL=

# ---- 开关 ----

# 只有极巨大冒险用。设成 1：一局没刷到闪光、打赢并且倒下次数和用时都在范围内时，重启游戏保留这张图（keep path）。
# 重启后下次进冒险要付极矿石，矿石不够时不要开。不写或者不是 1 就不保留
# KEEP_PATH=1
# 要存判定截图的步骤名字，用逗号分开。极巨大冒险的步骤：initialize、join、path、battle、catch、select_pokemon。
# 这些步骤里每次画面判定成功，都把截图存进这个脚本的日志目录下的 checks/，判定用的范围画成红框；
# battle 每一帧都会存，图很多。不写就都不存
# SAVE_CHECKS=join,battle
